<Window x:Class="WPFLabs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFLabs"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="Gainsboro">
            <MenuItem Header="Файл"></MenuItem>
        </Menu>
        <DockPanel>
            <StackPanel DockPanel.Dock="Left" Background="Gainsboro" Width="202">
                <Button Margin="10,15,10,25" Padding="0,10,0,10">
                    <TextBlock Text="Сгенерировать граф"></TextBlock>
                </Button>
                <Button Margin="10,0,10,10" Padding="0,10,0,10">
                    <TextBlock Text="Описание алгоритма Дэйкстры"></TextBlock>
                </Button>
                <Button Margin="10,0,10,10" Padding="0,10,0,10">
                    <TextBlock Text="Начать алгоритм Дэйкстры"></TextBlock>
                </Button>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="0,0,25,0" Padding="10,10,10,10">
                        <TextBlock Text="Play"></TextBlock>
                    </Button>
                    <Button Margin="0,0,25,0" Padding="10,10,10,10">
                        <TextBlock Text="Pause"></TextBlock>
                    </Button>
                    <Button Padding="10,10,10,10">
                        <TextBlock Text="Stop"></TextBlock>
                    </Button>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="0,10,25,0" Width="20">
                        <TextBlock Text="◀" HorizontalAlignment="Center"></TextBlock>
                    </Button>
                    <Button Margin="0,10,0,0" Width="20">
                        <TextBlock Text="▶" HorizontalAlignment="Center"></TextBlock>
                    </Button>
                </StackPanel>
                <Slider Margin="10,10,10,0" BorderThickness="5"></Slider>
                <TextBox Height="120" Margin="5,10,5,5"></TextBox>
            </StackPanel>
            <Image Source="{Binding}"></Image>
        </DockPanel>
    </DockPanel>
</Window>
