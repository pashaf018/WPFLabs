<Window x:Class="WPFLabs.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFLabs.ViewModel" d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
        mc:Ignorable="d"
        SizeChanged="Window_SizeChanged"
        Title="MainWindow" Height="Auto" Width="Auto">

    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <LinearGradientBrush x:Key="ColoredButtonGradientPlay" StartPoint="0,1" EndPoint="0,0" >
            <GradientStop Color="LightGreen" Offset="1.0"/>
            <GradientStop Color="Green" Offset="0.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ColoredButtonGradientPause" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="Orange" Offset="1.0"/>
            <GradientStop Color="OrangeRed" Offset="0.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ColoredButtonGradientStop" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="PaleVioletRed" Offset="1.0"/>
            <GradientStop Color="Red" Offset="0.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CosmosGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#03030F" Offset="0.0"/>
            <GradientStop Color="#0A0616" Offset="0.5"/>
            <GradientStop Color="#02010A" Offset="1.0"/>
        </LinearGradientBrush>
        <DrawingBrush x:Key="CosmocBackground"
                      x:Name="AnimatedStars"
                          TileMode="Tile" 
                          Viewport="0,0,150,150"
                          ViewportUnits="Absolute"
                          Stretch="None">
            <DrawingBrush.RelativeTransform>
                <TranslateTransform x:Name="BackgroundTranslate" X="0" Y="0"/>
            </DrawingBrush.RelativeTransform>
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,150,150"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="25,40" RadiusX="5" RadiusY="5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#80FFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="90,20" RadiusX="3" RadiusY="3"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#A0A0E0FF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="130,110" RadiusX="3.6" RadiusY="3.6"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#40FFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="50,120" RadiusX="3.6" RadiusY="3.6"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ButtonTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Rubik"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
        </Style>
        <Style x:Key="MainTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Rubik"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Heavy"/>
            <Setter Property="Foreground" Value="Wheat"/>
        </Style>

        <Style x:Key="ButtonHoverTrigger" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackgroundBorder" 
                            Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="HoverOverlay"  
                                    Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Offset)"  To="0.01" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Offset)"  From="1" To="1" BeginTime="0:0:0.05" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Offset)" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(Button.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Offset)"  From="0"  To="0.0" BeginTime="0:0:0.05" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" x:Name="BottomGrid" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*"></ColumnDefinition>
                <ColumnDefinition Width="20*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="3" Background="{StaticResource CosmosGradient}">
                <StackPanel Background="{StaticResource CosmocBackground}">
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="StackPanel.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation 
                                        Storyboard.TargetProperty="(StackPanel.Background).(Brush.RelativeTransform).(TranslateTransform.Y)" 
                                        From="0" To="1" Duration="0:0:3" RepeatBehavior="Forever"/>
                                    <DoubleAnimation 
                                        Storyboard.TargetProperty="(StackPanel.Background).(Brush.RelativeTransform).(TranslateTransform.X)" 
                                        From="0" To="1" Duration="0:0:3" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>
                    <Button Margin="10,15,10,15" Command="{Binding GenerateGraph}" Click="Button_Click">
                        <TextBlock Text="Сгенерировать граф" Style="{StaticResource ButtonTextStyle}"></TextBlock>
                    </Button>
                    <Button Margin="10,0,10,10" Background="LightGray" Command="{Binding ShowDesc}" Click="Button_Click">
                        <TextBlock Text="Описание алгоритма" Style="{StaticResource ButtonTextStyle}"></TextBlock>
                    </Button>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MainTextStyle}" Text="Откуда: " Margin="5,0,5,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource MainTextStyle}" Text="Куда: " Margin="5,0,5,0" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MainTextStyle}" Text="{Binding ElementName=SliderFrom, Path=Value}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource MainTextStyle}" Text="{Binding ElementName=SliderTo, Path=Value}"/>
                        <Slider x:Name="SliderFrom" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,0,5,0" Background="LightGray" Minimum="0" Maximum="{Binding MaximumSliderValue, UpdateSourceTrigger=PropertyChanged}" ValueChanged="SliderFrom_ValueChanged" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <Slider x:Name="SliderTo" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="5,0,5,0" Background="LightGray" Minimum="0" Maximum="{Binding MaximumSliderValue, UpdateSourceTrigger=PropertyChanged}" ValueChanged="SliderTo_ValueChanged" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </Grid>
                    <Button Margin="10,10,10,10" Background="LightGray" Command="{Binding StartAlgorithm}" Click="Button_Click">
                        <TextBlock Text="Начать алгоритм" Style="{StaticResource ButtonTextStyle}"></TextBlock>
                    </Button>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button Margin="0,0,15,0" Style="{StaticResource ButtonHoverTrigger}" Padding="10,0,10,0" Background="{StaticResource ColoredButtonGradientPlay}" Command="{Binding StartAlgorithm}" Click="Button_Click">
                            <TextBlock Text="Play" Style="{StaticResource ButtonTextStyle}"></TextBlock>
                        </Button>
                        <Button Margin="0,0,15,0" Style="{StaticResource ButtonHoverTrigger}" Padding="10,0,10,0" Background="{StaticResource ColoredButtonGradientPause}" Command="{Binding PauseAlgorithm}" Click="Button_Click">
                            <TextBlock Text="Pause" Style="{StaticResource ButtonTextStyle}"></TextBlock>
                        </Button>
                        <Button Padding="10,0,10,0" Style="{StaticResource ButtonHoverTrigger}" Background="{StaticResource ColoredButtonGradientStop}" Command="{Binding StopAlgorithm}" Click="Button_Click">
                            <TextBlock Text="Stop" Style="{StaticResource ButtonTextStyle}"></TextBlock>
                        </Button>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button Margin="0,10,15,0" Background="LightGray">
                            <TextBlock Text="◀" HorizontalAlignment="Center"></TextBlock>
                        </Button>
                        <Button Margin="0,10,0,0" Background="LightGray">
                            <TextBlock Text="▶" HorizontalAlignment="Center"></TextBlock>
                        </Button>
                    </StackPanel>
                    <Slider Margin="10,10,10,0" Minimum="0" Maximum="100" Value="10" ValueChanged="Slider_ValueChanged"></Slider>
                    <TextBox Margin="5,10,5,5" IsEnabled="False" Text="{Binding TextInfo, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="3">
                <Grid>
                    <MediaElement x:Name="VideoPlayer" Source="{Binding VideoSource, Mode=TwoWay}" LoadedBehavior="{Binding VideoLoadedBehavior}" MediaEnded="VideoPlayer_MediaEnded" UnloadedBehavior="Manual" Visibility="{Binding IsVideoVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Stretch="Fill"/>
                    <Image x:Name="MainImage" Source="{Binding BitmapSource, TargetNullValue='pack://WPFLabs:,,,/Images/WaitingCat.jpg'}" Stretch="Fill" SizeChanged="MainImage_SizeChanged" Visibility="{Binding IsImageVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </Grid>
        <Menu Background="Gainsboro" BorderThickness="2" BorderBrush="Black" HorizontalAlignment="Stretch">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch" LastChildFill="False"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="Файл" DockPanel.Dock="Left"></MenuItem>
            <MenuItem Click="MenuItem_Click" DockPanel.Dock="Right"></MenuItem>
        </Menu>
    </Grid>
</Window>
